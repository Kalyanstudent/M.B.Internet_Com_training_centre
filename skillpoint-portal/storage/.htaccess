# Disable script execution in storage upload directories
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Prevent execution of any scripts
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|pht|phar|inc|pl|py|cgi|sh|bash|exe|bat|cmd|dll)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Only allow safe media types
Options -ExecCGI -Indexes
